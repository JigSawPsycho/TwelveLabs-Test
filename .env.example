# DO NOT CREATE A .env YOURSELF, SEE `README.md` FOR SETUP INSTRUCTIONS

TWELVELABS_API_KEY=tlk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWELVELABS_INDEX_ID=67cec9caf45d9b64a58340fc
TWELVELABS_QUERY_TEXT=person

# Comma-separated list of video IDs approved to live in the test index.
# scripts/setup.js refuses to proceed, and the Jest suite refuses to run,
# if the index contains any ID outside this list — stray uploads would
# pollute filter/count assertions. Auto-populated by setup.js after a
# successful upload run.
ALLOWED_IDS=

# Color test videos used by `operator and searchOptions combinations`.
# Upload these into the index above, then paste their IDs here:
#   RED   - solid red video, voice says "red"
#   BLUE  - solid blue video, voice says "blue"
#   GREEN - solid green video, voice says "green"
#   RGB   - red+blue+green video, NO audio (used to verify that transcript
#           queries don't leak in visual matches)
RED_VIDEO_ID=
BLUE_VIDEO_ID=
GREEN_VIDEO_ID=
RGB_VIDEO_ID=

# Filter test videos. Each *_VID_IDS variable is a comma-separated list of
# video IDs that all match the named property. Upload videos that satisfy each
# bucket, then paste their IDs here.
#
#   5_SEC_VID_IDS         - videos with duration ~5 seconds
#   10_SEC_VID_IDS        - videos with duration ~10 seconds
#   400X400PX_VID_IDS     - videos with 400x400 pixel dimensions
#   800X800PX_VID_IDS     - videos with 800x800 pixel dimensions
#   TESTNAME_FILENAME     - the literal filename string used to filter on
#                           (must be the exact filename of the uploaded video)
#   TESTNAME_FILENAME_VID_ID - the video ID whose filename matches the above
5_SEC_VID_IDS=
10_SEC_VID_IDS=
400X400PX_VID_IDS=
800X800PX_VID_IDS=
TESTNAME_FILENAME=
TESTNAME_FILENAME_VID_ID=
